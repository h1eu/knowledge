#!/bin/sh
# Guard chống tái phạm bug escaping content (\(name) hiển thị thành (name)).
# Bỏ qua 1 lần:   git commit --no-verify
# Gỡ hẳn hook:    git config --unset core.hooksPath
node "$(git rev-parse --show-toplevel)/tools/check_content_escapes.js" || {
  echo ""
  echo "✗ Commit bị chặn: content escaping check thất bại (xem lỗi ở trên)."
  exit 1
}
